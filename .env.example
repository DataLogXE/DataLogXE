# cp .env.example .env

# Database password, must be set. Do not use the character ";" in it.
# The database takes it on the first start. Changing it in this file later does not change the database password.
POSTGRES_PASSWORD=

# Port of the web UI (HTTPS)
# HTTPS_PORT=8443

# Database memory: 128MB for a Pi, 256MB for a PC with 4 GB or more
# PG_SHARED_BUFFERS=128MB

# Key that encrypts the data source passwords in the database (base64, 32 bytes: openssl rand -base64 32).
# Not set: the app creates it on the first start as master.key in the app-data volume. Back it up with the
# database, without it the passwords must be entered again. Set it only to the key in use (content of master.key).
# DATALOG_MASTER_KEY=
