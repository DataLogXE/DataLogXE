<Project Sdk="Microsoft.NET.Sdk">

	<!-- S7CommPlus driver, LGPL-3.0-or-later (see LICENSE in this folder).
	     Protocol layer based on S7CommPlusDriver by Thomas Wiens. -->
	<PropertyGroup>
		<RootNamespace>S7CommPlusDriver</RootNamespace>
		<AssemblyName>S7CommPlus</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
		<NoWarn>$(NoWarn);CS0168;CS0219;CS0162;CS0649;CS0414</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
		<PackageReference Include="ComponentAce.Compression.Libs.zlib" Version="1.0.4" />
		<PackageReference Include="Serilog" Version="4.3.0" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>DataLogLib.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
